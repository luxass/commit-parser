{
  "name": "commit-parser",
  "version": "1.3.2",
  "description": "A tiny parser for conventional commits that extracts metadata like type, scope, breaking changes and references",
  "keywords": [
    "commit",
    "commit-parser",
    "convetional",
    "parser"
  ],
  "homepage": "https://github.com/luxass/commit-parser",
  "bugs": "https://github.com/luxass/commit-parser/issues",
  "license": "MIT",
  "author": {
    "name": "Lucas Nørgård",
    "email": "lucasnrgaard@gmail.com",
    "url": "https://luxass.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luxass/commit-parser.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "imports": {
    "#types": "./src/types.ts",
    "#git": "./src/git.ts",
    "#commits": "./src/commits.ts",
    "#parse": "./src/parse.ts",
    "#grouping": "./src/grouping.ts"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest --run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "quansync": "catalog:runtime"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "publint": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:test"
  },
  "packageManager": "pnpm@12.21.0"
}
